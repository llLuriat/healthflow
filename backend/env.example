# HealthFlow — Backend Environment Variables
# Copie este arquivo para .env e preencha os valores
# cp env.example .env

# ─── Servidor ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Banco de dados ──────────────────────────────────────────────────────────
# Dev local: usa postgres diretamente
DATABASE_URL=postgres://postgres:postgres@localhost:5432/healthflow
ADMIN_DATABASE_URL=postgres://postgres:postgres@localhost:5432/healthflow

# Pool de conexões
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONN_TIMEOUT_MS=5000

# ─── Autenticação JWT ────────────────────────────────────────────────────────
# PRODUÇÃO: gere com: openssl rand -hex 64
JWT_SECRET=dev_secret_change_in_production_use_openssl_rand_hex_64
JWT_EXPIRES_IN=15m

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173

# ─── Segurança multi-tenant ──────────────────────────────────────────────────
# Dev: true | PRODUÇÃO: SEMPRE false
ENABLE_UNSAFE_TENANT=true

# ─── Rate limiting (opcional — usa defaults se omitido) ──────────────────────
# MAX_GLOBAL_CONCURRENT=100
# TENANT_MAX_CONCURRENT_REQUESTS=20
# STATEMENT_TIMEOUT_MS=3000
# LOCK_TIMEOUT_MS=1000

# ─── Outbox Relay / Redis (opcional) ────────────────────────────────────────
# REDIS_URL=redis://localhost:6379
# OUTBOX_RELAY_ID=default
